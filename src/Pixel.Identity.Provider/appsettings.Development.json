{
  "Plugins": {
    "Collection": [
      {
        "Type": "EmailSender",
        "Path": "Plugins\\Messenger",
        "Name": "Pixel.Identity.Messenger.Console"
      },
      {
        "Type": "DbStore",
        "Path": "Plugins\\DbStore",
        "Name": "Pixel.Identity.Store.PostgreSQL"
      }
    ]
  },
  "ConnectionStrings": {
    "PostgreServerConnection": "host=localhost;port=5432;database=pixel_identity;username=postgres;password=123;"
  },
  "AllowUserRegistration": true,
  "InitAdminUser": "admin@pixel.com",
  "InitAdminUserPass": "Password@123",
  "IdentityHost": "http://localhost:44382/pauth",
  "AllowedOrigins": "http://localhost:44382",
  "AutoMigrate": true,
  "IdentityOptions": {
    "SignIn": {
      "RequireConfirmedAccount": true
    }
  }
}

